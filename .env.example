# Copy this to .env for LOCAL testing only. On Render, set these as real
# Environment Variables in the dashboard instead -- never commit a real .env file.

# Full JSON key content of your Google Service Account, as ONE line/string.
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Drive folder ID where managers upload their regional Excel files.
# Get this from the folder's URL: drive.google.com/drive/folders/<THIS_PART>
RAW_FOLDER_ID=

# Drive folder ID where the generated Master Report should be uploaded.
OUTPUT_FOLDER_ID=
